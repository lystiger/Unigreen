# Base URL of the Uni-Green API. Server-side calls inside Compose use the
# service name; the browser needs a host-reachable URL.
UNIGREEN_API_URL=http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Absolute origin of this site, used for canonical URLs and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
