# Public HTTPS hostname. DNS must point to the deployment host.
UNIGREEN_ENV_FILE=.env.production
UNIGREEN_DOMAIN=example.com

# Application runtime
UNIGREEN_ENVIRONMENT=production
UNIGREEN_LOG_LEVEL=INFO
UNIGREEN_ALLOWED_ORIGINS=["https://example.com"]
UNIGREEN_PUBLIC_MEDIA_BASE_URL=https://example.com/api/v1/public/media
UNIGREEN_STORAGE_ROOT=/app/storage
UNIGREEN_READINESS_TIMEOUT_SECONDS=2.0

# PostgreSQL. URL-encode special characters in UNIGREEN_DATABASE_URL.
UNIGREEN_POSTGRES_DB=unigreen
UNIGREEN_POSTGRES_USER=unigreen
UNIGREEN_POSTGRES_PASSWORD=replace-with-a-strong-password
UNIGREEN_DATABASE_URL=postgresql+asyncpg://unigreen:replace-with-a-strong-password@db:5432/unigreen

# Redis
UNIGREEN_REDIS_PASSWORD=replace-with-a-different-strong-password
UNIGREEN_REDIS_URL=redis://:replace-with-a-different-strong-password@redis:6379/0

# Staff authentication
UNIGREEN_STAFF_SESSION_COOKIE_NAME=ug_staff_session
UNIGREEN_CSRF_COOKIE_NAME=ug_csrf
UNIGREEN_STAFF_SESSION_HOURS=12
UNIGREEN_LOGIN_ATTEMPT_LIMIT=5
UNIGREEN_LOGIN_ATTEMPT_WINDOW_SECONDS=900

# Inquiry email notifications
UNIGREEN_QUOTATION_RECIPIENT_EMAIL=sales@example.com
UNIGREEN_SMTP_HOST=smtp.example.com
UNIGREEN_SMTP_PORT=587
UNIGREEN_SMTP_USERNAME=mailer@example.com
UNIGREEN_SMTP_PASSWORD=replace-with-an-app-password
UNIGREEN_SMTP_USE_TLS=true
UNIGREEN_SMTP_FROM_EMAIL=sales@example.com
